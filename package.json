{
  "name": "ropide-vscode-plugin",
  "displayName": "RopIDE for VS Code",
  "description": "VS Code editor for CASIO fx-991 CN X ROP (.rop) files — syntax highlighting, address gutter, gadget manager and one-click compile.",
  "version": "0.1.0",
  "publisher": "yaing-yan",
  "license": "GPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yaing-Yan/ropide-vscode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Yaing-Yan/ropide-vscode-plugin/issues"
  },
  "homepage": "https://github.com/Yaing-Yan/ropide-vscode-plugin#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "rop",
    "casio",
    "fx-991",
    "ropide"
  ],
  "activationEvents": [
    "onCustomEditor:ropide.rop",
    "onCommand:ropide.newFile",
    "onCommand:ropide.openFile",
    "onCommand:ropide.compile",
    "onCommand:ropide.showGadgets",
    "onCommand:ropide.openMarket"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "ropide.rop",
        "displayName": "RopIDE ROP Editor",
        "selector": [
          {
            "filenamePattern": "*.rop"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ropide.newFile",
        "title": "RopIDE: New .rop File",
        "icon": "$(new-file)"
      },
      {
        "command": "ropide.openFile",
        "title": "RopIDE: Open .rop File",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ropide.compile",
        "title": "RopIDE: Compile",
        "icon": "$(play)"
      },
      {
        "command": "ropide.showGadgets",
        "title": "RopIDE: Show Gadgets",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "ropide.openMarket",
        "title": "RopIDE: Program Market",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ropide.newFile",
          "when": "true"
        },
        {
          "command": "ropide.openFile",
          "when": "true"
        },
        {
          "command": "ropide.compile",
          "when": "resourceExtname == .rop"
        },
        {
          "command": "ropide.showGadgets",
          "when": "resourceExtname == .rop"
        },
        {
          "command": "ropide.openMarket",
          "when": "resourceExtname == .rop"
        }
      ]
    },
    "configuration": {
      "title": "RopIDE",
      "properties": {
        "ropide.casioemuRamScript": {
          "type": "string",
          "default": "",
          "description": "casioemu_ram.py 的路径（留空自动检测 ~/casioemu/tools/casioemu_ram.py）。"
        },
        "ropide.casioemuPython": {
          "type": "string",
          "default": "python3",
          "description": "用于运行 casioemu_ram.py 的 Python 解释器（如 python3 / python）。"
        },
        "ropide.casioemuModelDir": {
          "type": "string",
          "default": "",
          "description": "CasioEmuMsvc 模型目录（留空自动检测）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --outfile=dist/extension.js",
    "watch": "esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --outfile=dist/extension.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.3"
  }
}
